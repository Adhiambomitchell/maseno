# Copy this file to .env and fill it in. Never share or upload .env.

# Turn on for the live site (secure cookies, no debug)
PRODUCTION=1

# --- Render free plan (leave all of these out on PythonAnywhere) ---
# Postgres connection string from Neon/Supabase/etc. Empty = use the local SQLite file.
DATABASE_URL=
# Files are kept inside the database when DATABASE_URL is set. Cap on each upload:
MAX_UPLOAD_MB=3
# Email over HTTPS (Brevo). MAIL_DEFAULT_SENDER must be a sender you verified in Brevo.
BREVO_API_KEY=

# Leave SECRET_KEY empty to auto-create one, or set your own long random string
SECRET_KEY=

# Admin login created on first run
ADMIN_EMAIL=admin@maseno.ac.ke
ADMIN_PASSWORD=choose-a-strong-password

# Geoapify key (https://myprojects.geoapify.com)
GEOAPIFY_API_KEY=

# Email for verification links. For Gmail use an App Password, not your normal password.
# Leave MAIL_USERNAME / MAIL_PASSWORD empty to skip email verification.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
